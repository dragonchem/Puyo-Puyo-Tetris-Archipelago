<UserControl 
    x:Class="Puyo_Puyo_Tetris_Archipelago.Views.APDevMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:v="clr-namespace:Puyo_Puyo_Tetris_Archipelago.Views"
    xmlns:local="clr-namespace:Puyo_Puyo_Tetris_Archipelago.Views"
    mc:Ignorable="d" MinHeight="450" MinWidth="800"
    Background="White"
>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Name="AttachStatusText" Text="NOT ATTACHED" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"/>

        <ScrollViewer Grid.Row="1" Margin="10">
            <ItemsControl Margin="0,0,5,0" Name="AdventureStages" d:ItemsSource="{d:SampleData ItemCount=100}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="10" Columns="10"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="Stage_Click" MouseRightButtonUp="Stage_RightClick">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="LightGray"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ApUnlocked}" Value="True">
                                            <Setter Property="Background" Value="LightGreen" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <TextBlock>
                                    <Run Text="{Binding Act}" />
                                    <Run Text="-"/>
                                    <Run Text="{Binding Stage}" />
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Stars: "/>
                                    <Run Text="{Binding Stars}" />
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="Left click = unlock, Right click = Cycle stars" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,20"/>
    </Grid>
</UserControl>
