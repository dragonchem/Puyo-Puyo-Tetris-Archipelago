<UserControl 
    x:Class="Puyo_Puyo_Tetris_Archipelago.Views.APSetupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:v="clr-namespace:Puyo_Puyo_Tetris_Archipelago.Views"
    xmlns:local="clr-namespace:Puyo_Puyo_Tetris_Archipelago.Views"
    xmlns:ppts="clr-namespace:Puyo_Puyo_Tetris_Archipelago.Views.Controls.Shapes"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
>
    <!--Main grid, layout header auto, body fill-->
    <Grid Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="6*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <ppts:GridBackground Grid.RowSpan="6"/>

        <Grid Grid.Row="4" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ppts:PptShape Point1="5,0" Point2="100,0" Point3="100,100" Point4="0,100" Grid.Column="1" Scalable="True" Fill="#0071BC" InnerOutlineBrush="White" OuterOutlineBrush="#BABABA" OuterOutlineWidth="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <ppts:OutlinedText OutlineBrush="#135784" Scalable="True" Text="Game Status:" Margin="10" LetterOffset="4" LetterRotation="4" TextRotation="-4" Grid.Column="0" Grid.Row="2" Grid.RowSpan="2"></ppts:OutlinedText>
                    <ppts:OutlinedText OutlineBrush="#821313" Scalable="True" Text="Not Attached" Margin="10" LetterOffset="4" LetterRotation="4" TextRotation="-4" Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" x:Name="AttachedText"></ppts:OutlinedText>
                </Grid>
            </ppts:PptShape>
        </Grid>

        <!--Body grid, centered stretch, content fill-->
        <Grid Name="Body" Grid.Row="1" Grid.RowSpan="4">
            <ppts:PptShape Grid.RowSpan="4" Grid.ColumnSpan="4" Scalable="True" Margin="-5,-5,-5,-5" Fill="White" InnerOutlineBrush="#646664" InnerOutlineWidth="5" OuterOutlineWidth="0" ShadowOffset="0,8" Point1="0,10" Point2="0,110">
            </ppts:PptShape>
            <Grid Name="BodyContainer" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!--Scrollviewer with stackpanel, center floating, content size fill-->
                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"  VerticalAlignment="Center" HorizontalAlignment="Stretch" Padding="10">
                    <StackPanel Name="InputFields">

                        <!--per input grid, inputs 3 times as wide as the label-->
                        <Grid Name="HostInputGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Host:" Margin="0,5"/>
                            <TextBox Grid.Column="1" Name="HostTextBox" Margin="0,5"/>
                        </Grid>

                        <Grid Name="PortInputGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Port:" Margin="0,5"/>
                            <TextBox Grid.Column="1" Name="PortTextBox" Margin="0,5" Text="38281"/>
                        </Grid>

                        <Grid Name="SlotInputGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Slot:" Margin="0,5"/>
                            <TextBox Grid.Column="1" Name="SlotTextBox" Margin="0,5"/>
                        </Grid>

                        <Grid Name="PasswordInputGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="3*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Password:" Margin="0,5"/>
                            <PasswordBox Grid.Column="1" Name="PasswordBox" Margin="0,5"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!--Connect button, stretch horizontally, auto height-->
                <Button Grid.Row="1" Click="ConnectButton_Click" Name="ConnectButton" Content="Connect" HorizontalAlignment="Stretch" Margin="0,10" />
            </Grid>
        </Grid>



        <!--Header grid, TODO-->
        <Grid Grid.Row="0" Grid.RowSpan="2" Name="Header" Margin="0,0,0,0">
            <Grid Name="HeaderContainer">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ppts:PptShape Scalable="True" ShowDots="True" Point1="0,0" Point2="690,0" Point3="580,130" Point4="0,150" DotAngle="0" GrowAngle="0" DotMinDiameter="5" DotMaxDiameter="5" DotSpacing="10" InnerOutlineBrush="#5800B0" OuterOutlineBrush="White" OuterOutlineWidth="5" InnerOutlineWidth="5">
                    <ppts:PptShape.Fill>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                            <GradientStop Color="#C98CF0" Offset="0"/>
                            <GradientStop Color="#9E55E0" Offset="1"/>
                        </LinearGradientBrush>
                    </ppts:PptShape.Fill>
                    <ppts:PptShape.DotBrush>
                        <DrawingBrush>
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Brush="#80EDDCB6">
                                    <GeometryDrawing.Geometry>
                                        <EllipseGeometry RadiusX="1" RadiusY="1" Center="0,0"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </ppts:PptShape.DotBrush>
                    <ppts:OutlinedText OutlineBrush="#5800B0" Scalable="True" Text="Connect" Margin="10" LetterOffset="4" LetterRotation="4" TextRotation="-8"></ppts:OutlinedText>
                </ppts:PptShape>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
